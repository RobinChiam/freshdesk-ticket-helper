{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/ai/**/*.ts",
    "src/preload/**/*.ts",
    "src/database/**/*.ts",
    "src/freshdesk/**/*.ts",
    "src/sanitizer/**/*.ts",
    "src/renderer/ticketContextGuard.ts",
    "tests/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["tests/electron-smoke.test.ts"]
}
