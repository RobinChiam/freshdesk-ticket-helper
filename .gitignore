# Dependencies
node_modules/

# Build outputs
dist/
out/
release/
*.tsbuildinfo

# Logs and caches
*.log
npm-debug.log*
.eslintcache
.vite/
coverage/
playwright-report/
test-results/

# Environment and secrets — never commit real credentials
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
credentials.json
# Repository-local secrets directory only (not apps/**/secrets/ source folders)
/secrets/
# Runtime encrypted vault files (normally under userData, never under source)
*.vault

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Electron / packaging
apps/desktop/dist/
apps/desktop/out/
apps/desktop/release/

# Local SQLite databases (non-secret state still stays local)
*.sqlite
*.sqlite3
*.db

# Local-only agent working docs (not shipped in a clean clone)
docs/
